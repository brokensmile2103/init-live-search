msgid "https://inithtml.com/plugin/init-live-search/"
msgstr ""

#. Description of the plugin
#: init-live-search.php
msgid ""
"A fast, lightweight, and extensible live search modal for WordPress. Built "
"with Vanilla JS and powered by the REST API."
msgstr ""
"Giải pháp tìm kiếm trực tiếp nhanh, gọn và linh hoạt cho WordPress — phát "
"triển bằng JavaScript thuần, tích hợp sâu với REST API."

#. Author of the plugin
#: init-live-search.php
msgid "Init HTML"
msgstr ""

#. Author URI of the plugin
#: init-live-search.php
msgid "https://inithtml.com/"
msgstr ""

#: includes/abilities-api.php:21
msgid "Abilities exposed by the Init Live Search plugin."
msgstr "Các ability được plugin Init Live Search cung cấp."

#: includes/abilities-api.php:32
msgid "Search Posts"
msgstr "Tìm kiếm bài viết"

#: includes/abilities-api.php:33
msgid ""
"Searches posts using the Init Live Search engine (FULLTEXT index, "
"Meilisearch, or LIKE fallback) and returns matching results."
msgstr ""

#: includes/abilities-api.php:40
msgid "The search term."
msgstr "Từ khóa tìm kiếm."

#: includes/abilities-api.php:61
msgid "Get Related Posts"
msgstr "Lấy bài viết liên quan"

#: includes/abilities-api.php:62
msgid ""
"Returns posts related to a given post ID, using the same keyword-similarity "
"matching as the [init_live_search_related_posts] shortcode."
msgstr ""

#: includes/abilities-api.php:69
msgid "The reference post ID to find related posts for."
msgstr "ID bài viết gốc để tìm bài liên quan."

#: includes/abilities-api.php:74
msgid "Maximum number of related posts to return."
msgstr "Số lượng bài liên quan tối đa trả về."

#: includes/abilities-api.php:81
msgid "Restrict related posts to a specific post type."
msgstr "Giới hạn bài liên quan theo một loại bài viết cụ thể."

#: includes/abilities-api.php:129
msgid "A non-empty search term is required."
msgstr "Cần nhập từ khóa tìm kiếm (không được để trống)."

#: includes/abilities-api.php:145
msgid "A valid, published post ID is required."
msgstr "Cần một ID bài viết hợp lệ và đã xuất bản."

#: includes/ajax.php:612
msgid ""
"Missing Host or Index. Fill these in under Settings > Init Live Search > "
"Meilisearch — enabling \"Use Meilisearch as the primary search source\" is "
"not required to build the index."
msgstr ""
"Thiếu Host hoặc Index. Điền vào ở Settings > Init Live Search > Meilisearch "
"— không cần bật \"Use Meilisearch as the primary search source\" để lập chỉ "
"mục."

#: includes/ajax.php:617
msgid "Missing Admin/Indexing Key."
msgstr "Thiếu Admin/Indexing Key."

#: includes/meilisearch.php:167
msgid "Please fill in Host, Index, and Search Key before testing."
msgstr ""
"Vui lòng nhập đầy đủ Host, Index và Search Key trước khi kiểm tra kết nối."

#. translators: %d: HTTP status code
#: includes/meilisearch.php:192
msgid ""
"Meilisearch returned HTTP error %d. Please check your Host / Index / Key."
msgstr ""
"Meilisearch trả về mã lỗi HTTP %d. Vui lòng kiểm tra lại Host / Index / Key."

#. translators: %d: HTTP status code
#: includes/meilisearch.php:465
msgid "HTTP error %d from Meilisearch."
msgstr "Meilisearch trả về lỗi HTTP %d."

#: includes/meilisearch.php:486
msgid "Missing Admin/Indexing Key, Host, or Index."
msgstr "Thiếu Admin/Indexing Key, Host, hoặc Index."

#. translators: %s is the discount percentage (e.g. 20 for 20%)
#: includes/rest-api.php:671
msgid "Save %s%%"
msgstr "Giảm %s%%"

#. translators: %s is the monetary discount amount (e.g. $10)
#: includes/rest-api.php:674
msgid "Save %s"
msgstr "Giảm %s"

#. translators: %d is the number of remaining uses
#: includes/rest-api.php:681
msgid "Remaining: %d uses"
msgstr "Còn lại: %d lượt"

#: includes/rest-api.php:683
msgid "Unlimited uses"
msgstr "Không giới hạn lượt"

#. translators: %s is the expiration date
#: includes/rest-api.php:688
msgid "Expires on: %s"
msgstr "Hết hạn: %s"

#: includes/rest-api.php:690
msgid "No expiration"
msgstr "Không giới hạn thời gian"

#: includes/settings-page.php:36 includes/settings-page.php:68
msgid "Init Live Search Settings"
msgstr "Cài đặt Init Live Search"

#: includes/settings-page.php:61 includes/settings/general.php:9
msgid "General Settings"
msgstr "Cài đặt chung"

#: includes/settings-page.php:62 includes/settings/meilisearch.php:8
msgid "Meilisearch"
msgstr "Meilisearch"

#: includes/settings-page.php:63
msgid "Synonyms"
msgstr "Từ đồng nghĩa"

#: includes/settings-page.php:64
msgid "Analytics"
msgstr "Phân tích dữ liệu"

#: includes/settings-page.php:86
msgid "Invalid tab."
msgstr "Tab không hợp lệ."

#: includes/settings-page.php:150
msgid ""
"FULLTEXT search index could not be enabled: your MySQL/MariaDB server does "
"not support InnoDB FULLTEXT indexes on this table. The plugin will keep "
"using the standard database search."
msgstr ""
"Không thể bật FULLTEXT search index: máy chủ MySQL/MariaDB của bạn không hỗ "
"trợ FULLTEXT index của InnoDB trên bảng này. Plugin sẽ tiếp tục dùng tìm "
"kiếm database tiêu chuẩn."

#: includes/settings-page.php:276
msgid "Testing..."
msgstr "Đang kiểm tra..."

#: includes/settings-page.php:277
msgid "Connected successfully"
msgstr "Kết nối thành công"

#: includes/settings-page.php:278
msgid "documents"
msgstr "tài liệu"

#: includes/settings-page.php:279
msgid "Connection failed"
msgstr "Kết nối thất bại"

#: includes/settings-page.php:280
msgid "Unknown error"
msgstr "Lỗi không xác định"

#: includes/settings-page.php:281
msgid "Started — reindexing in the background…"
msgstr "Đã bắt đầu — đang lập chỉ mục ở nền…"

#: includes/settings-page.php:282 includes/settings/meilisearch.php:126
msgid "Reindexing in the background (about 200 posts every 5 seconds)…"
msgstr "Đang lập chỉ mục ở nền (khoảng 200 bài mỗi 5 giây)…"

#: includes/settings-page.php:283
msgid "Background reindex stopped after repeated errors:"
msgstr "Tiến trình lập chỉ mục nền đã dừng do lỗi lặp lại:"

#: includes/settings-page.php:284
msgid "Index last built:"
msgstr "Lần build chỉ mục gần nhất:"

#. translators: %1$d: number of skipped posts, %2$s: comma-separated post IDs
#: includes/settings-page.php:286 includes/settings/meilisearch.php:154
msgid ""
"%1$d post(s) were too large to send to Meilisearch even individually and "
"were skipped (post IDs: %2$s). Increase the payload size limit on "
"Meilisearch (or any reverse proxy in front of it), or shorten these posts, "
"then run Reindex Now again."
msgstr ""
"%1$d bài viết quá lớn để gửi lên Meilisearch dù đã gửi riêng lẻ nên đã bị bỏ "
"qua (ID bài viết: %2$s). Hãy tăng giới hạn dung lượng payload trên "
"Meilisearch (hoặc trên reverse proxy phía trước, nếu có), hoặc rút ngắn nội "
"dung các bài viết này, rồi chạy lại Reindex Now."

#: includes/settings/analytics.php:31
msgid "Search Analytics"
msgstr "Thống kê tìm kiếm"

#: includes/settings/analytics.php:34
msgid ""
"Below is a temporary log of recent search queries. No IPs or personal data "
"are stored."
msgstr ""
"Dưới đây là nhật ký tạm thời của các truy vấn tìm kiếm gần đây. Không lưu IP "
"hay dữ liệu cá nhân."

#: includes/settings/analytics.php:42
msgid "Group similar queries"
msgstr "Gộp các truy vấn giống nhau"

#: includes/settings/analytics.php:45
msgid "Clear All Logs"
msgstr "Xóa toàn bộ nhật ký"

#: includes/settings/analytics.php:46
msgid "Export CSV"
msgstr "Xuất CSV"

#: includes/settings/analytics.php:70
msgid "No data recorded yet."
msgstr "Chưa có dữ liệu được ghi lại."

#: includes/settings/analytics.php:76
msgid "Time"
msgstr "Thời gian"

#: includes/settings/analytics.php:77
msgid "Query"
msgstr "Truy vấn"

#: includes/settings/analytics.php:78
msgid "Results"
msgstr "Kết quả"

#: includes/settings/general.php:12
msgid ""
"Configure how the search modal is triggered, how matching and fallback "
"behave, and how results are displayed on the frontend."
msgstr ""
"Cấu hình cách kích hoạt modal tìm kiếm, cách khớp từ khóa và fallback hoạt "
"động, cùng cách hiển thị kết quả ở giao diện người dùng."

#: includes/settings/general.php:22
msgid "Search Triggers"
msgstr "Cách kích hoạt tìm kiếm"

#: includes/settings/general.php:25
msgid "Post Types to Include"
msgstr "Loại nội dung cần tìm kiếm"

#: includes/settings/general.php:38
msgid "Trigger methods to open modal"
msgstr "Cách để mở giao diện tìm kiếm"

#: includes/settings/general.php:43
msgid "Attach event to input[name=\"s\"]"
msgstr "Gắn sự kiện vào input[name=\"s\"]"

#: includes/settings/general.php:47
msgid "Triple click anywhere on the page"
msgstr "Nhấp chuột 3 lần liên tiếp vào trang"

#: includes/settings/general.php:51
msgid "Press Ctrl + / (or Cmd + / on Mac)"
msgstr "Nhấn Ctrl + / (hoặc Cmd + / trên Mac)"

#: includes/settings/general.php:55
msgid "Select one or more methods to trigger the search modal."
msgstr "Chọn một hoặc nhiều cách để mở hộp tìm kiếm."

#: includes/settings/general.php:60
msgid "Search Behavior"
msgstr "Hành vi tìm kiếm"

#: includes/settings/general.php:63
msgid "Enable Slash Commands?"
msgstr "Bật Slash Command?"

#: includes/settings/general.php:67
msgid ""
"Allow search commands starting with \"/\" such as /recent, /id, /tag, etc."
msgstr ""
"Cho phép sử dụng các lệnh tìm kiếm bắt đầu bằng dấu \"/\" như /recent, /id, /"
"tag, v.v."

#: includes/settings/general.php:72
msgid "Cross-site Search Domains"
msgstr "Tên miền tìm kiếm liên site"

#: includes/settings/general.php:76
msgid "Enter one site per line in the format: Site Name|https://example.com/"
msgstr "Nhập mỗi dòng một site theo định dạng: Tên site|https://example.com/"

#: includes/settings/general.php:77
msgid ""
"When filled, your search will fetch results from these additional domains "
"and merge them into one list."
msgstr ""
"Khi có dữ liệu, hệ thống sẽ lấy kết quả từ các domain này và gộp chung vào "
"một danh sách."

#: includes/settings/general.php:78
msgid ""
"Each external site must also have the Init Live Search plugin installed and "
"active."
msgstr "Mỗi site bên ngoài cũng phải cài và kích hoạt plugin Init Live Search."

#: includes/settings/general.php:83
msgid "Default Slash Command on Modal Open"
msgstr "Slash command mặc định khi mở hộp tìm kiếm"

#: includes/settings/general.php:90
msgid "None (do not preload anything)"
msgstr "Không tải trước gì cả"

#: includes/settings/general.php:91
msgid "Default (/recent)"
msgstr "Mặc định (/recent)"

#: includes/settings/general.php:92
msgid "Related Posts (use /related)"
msgstr "Bài viết liên quan (dùng /related)"

#: includes/settings/general.php:93
msgid "Smart Detection (based on current page)"
msgstr "Tự động nhận diện (theo trang hiện tại)"

#: includes/settings/general.php:97
msgid "Popular Posts (use /popular)"
msgstr "Bài viết phổ biến (dùng /popular)"

#: includes/settings/general.php:98
msgid "Trending Posts (use /trending)"
msgstr "Bài viết xu hướng (dùng /trending)"

#: includes/settings/general.php:102
msgid "Continue Reading (use /read)"
msgstr "Đọc tiếp (dùng /read)"

#: includes/settings/general.php:116
msgid ""
"Choose a default slash command to run automatically when the search modal "
"opens."
msgstr "Chọn slash command mặc định để tự động chạy khi hộp tìm kiếm được mở."

#: includes/settings/general.php:117
msgid ""
"“Smart Detection” automatically detects based on current page: /related for "
"posts, /product for shop pages, taxonomy-based commands, etc."
msgstr ""
"“Tự động nhận diện” sẽ chọn lệnh phù hợp theo trang hiện tại: /related cho "
"bài viết, /product cho trang cửa hàng, hoặc các lệnh dựa trên chuyên mục, "
"thẻ, v.v."

#: includes/settings/general.php:118
msgid ""
"“Popular”, “Trending” and “Read” options are only available if their "
"respective plugins are active."
msgstr ""
"Tuỳ chọn “Popular”, “Trending” và “Read” chỉ hiển thị nếu các plugin tương "
"ứng đang hoạt động."

#: includes/settings/general.php:123
msgid "Only run /related on Single pages?"
msgstr "Chỉ chạy /related trên trang Single?"

#: includes/settings/general.php:127
msgid "Only execute the /related command when viewing a single post page."
msgstr ""
"Chỉ tự động chạy lệnh /related khi đang xem trang bài viết đơn lẻ (single "
"post)."

#: includes/settings/general.php:132
msgid "Exclude /related on pages with these slug keywords"
msgstr "Không chạy /related ở các trang có slug chứa từ khóa sau"

#: includes/settings/general.php:136
msgid ""
"Enter one keyword per line. If the current page slug contains any of these "
"keywords, /related will not auto-run."
msgstr ""
"Nhập mỗi từ khóa một dòng. Nếu slug của trang hiện tại chứa bất kỳ từ khóa "
"này, /related sẽ không tự động chạy."

#: includes/settings/general.php:141
msgid "Use WordPress Native Search?"
msgstr "Dùng tìm kiếm mặc định của WordPress?"

#: includes/settings/general.php:145
msgid ""
"Bypass all custom search logic and use WordPress built-in WP_Query search "
"instead."
msgstr ""
"Bỏ qua toàn bộ logic tìm kiếm tùy chỉnh và dùng WP_Query mặc định của "
"WordPress."

#: includes/settings/general.php:147
msgid ""
"Recommended for small sites or when using third-party search plugins (e.g. "
"SearchWP, ElasticPress) that hook into WP_Query."
msgstr ""
"Khuyến nghị cho site nhỏ hoặc khi dùng plugin tìm kiếm bên thứ ba (ví dụ: "
"SearchWP, ElasticPress) có hook vào WP_Query."

#: includes/settings/general.php:151
msgid "Search Mode"
msgstr "Chế độ tìm kiếm"

#: includes/settings/general.php:156
msgid "Title Only"
msgstr "Chỉ tiêu đề"

#: includes/settings/general.php:160
msgid "Init Smart Tag-Aware Search"
msgstr "Init Smart Tag-Aware Search"

#: includes/settings/general.php:162
msgid ""
"This mode matches against post title and tag names. Ideal for content with "
"rich tagging."
msgstr ""
"Chế độ này sẽ dò theo tiêu đề và tên tag. Thích hợp cho nội dung có gắn tag "
"kỹ lưỡng."

#: includes/settings/general.php:165
msgid "Title and Excerpt"
msgstr "Tiêu đề và trích đoạn"

#: includes/settings/general.php:169
msgid "Title, Excerpt and Content"
msgstr "Tiêu đề, trích đoạn và nội dung"

#: includes/settings/general.php:175
msgid "FULLTEXT Search Index"
msgstr "FULLTEXT Search Index"

#: includes/settings/general.php:204
msgid ""
"Use a MySQL FULLTEXT index for Title/Excerpt/Content matching instead of "
"LIKE queries."
msgstr ""
"Dùng FULLTEXT index của MySQL để khớp Tiêu đề/Trích dẫn/Nội dung thay cho "
"truy vấn LIKE."

#: includes/settings/general.php:207
msgid ""
"Recommended for large sites (many thousands of posts) on the standard "
"database search pipeline — significantly faster than LIKE, with no external "
"service required. Tag, SEO metadata, and ACF field matching are unaffected "
"and keep working as before."
msgstr ""
"Khuyên dùng cho site lớn (hàng nghìn bài viết trở lên) đang chạy pipeline "
"tìm kiếm database chuẩn — nhanh hơn đáng kể so với LIKE, không cần dịch vụ "
"ngoài. Tìm theo Thẻ (tag), SEO metadata và trường ACF không bị ảnh hưởng, "
"vẫn hoạt động như cũ."

#: includes/settings/general.php:211
msgid ""
"Not available: your MySQL/MariaDB server does not appear to support InnoDB "
"FULLTEXT indexes on this table."
msgstr ""
"Không khả dụng: máy chủ MySQL/MariaDB của bạn có vẻ không hỗ trợ FULLTEXT "
"index của InnoDB trên bảng này."

#: includes/settings/general.php:215
msgid "Re-check support"
msgstr "Kiểm tra lại"

#: includes/settings/general.php:217
msgid ""
"Runs the capability check again — useful if this was a temporary server "
"issue."
msgstr ""
"Chạy lại bước kiểm tra khả năng hỗ trợ — hữu ích nếu lần trước server gặp sự "
"cố tạm thời."

#: includes/settings/general.php:222
msgid "Settings saved. Checking indexing status…"
msgstr "Đã lưu cài đặt. Đang kiểm tra trạng thái lập chỉ mục…"

#: includes/settings/general.php:230
msgid ""
"Building the index automatically in the background (about 300 posts every 5 "
"seconds) — no action needed. Progress relies on WP-Cron, so it advances "
"fastest on sites with regular visitor traffic."
msgstr ""
"Đang tự động xây dựng chỉ mục ở nền (khoảng 300 bài mỗi 5 giây) — không cần "
"làm gì thêm. Tiến độ phụ thuộc vào WP-Cron, nên sẽ chạy nhanh hơn trên site "
"có lượt truy cập đều đặn."

#: includes/settings/general.php:233 includes/settings/general.php:263
msgid "You can run this manually any time via WP-CLI:"
msgstr "Bạn cũng có thể chạy tay bất cứ lúc nào qua WP-CLI:"

#: includes/settings/general.php:238
msgid ""
"Background indexing isn't running right now — WP-Cron may be disabled on "
"this site (DISABLE_WP_CRON)."
msgstr ""
"Tiến trình lập chỉ mục nền hiện không chạy — có thể site đã tắt WP-Cron "
"(DISABLE_WP_CRON)."

#: includes/settings/general.php:242
msgid "Run Now"
msgstr "Chạy Ngay"

#: includes/settings/general.php:244
msgid ""
"Processes a batch immediately (up to ~20 seconds), bypassing WP-Cron "
"entirely. Click again if it isn't finished after one click."
msgstr ""
"Xử lý ngay 1 đợt (tối đa ~20 giây), không phụ thuộc WP-Cron. Nếu bấm 1 lần "
"chưa xong, bấm lại thêm lần nữa."

#: includes/settings/general.php:247
msgid "Or run it manually via WP-CLI:"
msgstr ""

#. translators: %s: date/time the index was last built
#: includes/settings/general.php:257 includes/settings/meilisearch.php:143
msgid "Index last built: %s."
msgstr "Lần build chỉ mục gần nhất: %s."

#: includes/settings/general.php:270
msgid "Enable + / - Search Operators?"
msgstr "Bật toán tử tìm kiếm + / -?"

#: includes/settings/general.php:274
msgid "Allow using +word to force match, -word to exclude."
msgstr "Cho phép dùng +từ để bắt buộc, -từ để loại trừ."

#: includes/settings/general.php:276
msgid ""
"Enable this if you want to support advanced users using must-have (+) and "
"must-not-have (-) keyword operators."
msgstr ""
"Bật tuỳ chọn này nếu bạn muốn hỗ trợ người dùng nâng cao với toán tử bắt "
"buộc (+) và loại trừ (-)."

#: includes/settings/general.php:280
msgid "Show Excerpt in Search Results?"
msgstr "Hiển thị đoạn trích trong kết quả tìm kiếm?"

#: includes/settings/general.php:284
msgid "Display the post excerpt below each result item in the modal."
msgstr "Hiển thị đoạn trích của bài viết bên dưới mỗi kết quả trong modal."

#: includes/settings/general.php:286
msgid "If disabled, excerpt will be omitted from results to simplify the UI."
msgstr ""
"Nếu tắt, đoạn trích sẽ bị loại bỏ khỏi kết quả để làm giao diện gọn hơn."

#: includes/settings/general.php:290
msgid "Use First Image as Thumbnail Fallback?"
msgstr "Sử dụng ảnh đầu tiên làm thumbnail dự phòng?"

#: includes/settings/general.php:299
msgid ""
"Automatically extract the first image from post content when no featured "
"image is available."
msgstr ""
"Tự động lấy ảnh đầu tiên trong nội dung bài viết khi không có ảnh đại diện."

#: includes/settings/general.php:303
msgid ""
"Useful for older posts or sites that do not consistently use featured images."
msgstr ""
"Hữu ích cho các bài viết cũ hoặc website không sử dụng ảnh đại diện một cách "
"đồng nhất."

#: includes/settings/general.php:308
msgid "Search in ACF Fields (Advanced)"
msgstr "Tìm trong trường ACF (Nâng cao)"

#: includes/settings/general.php:311
msgid ""
"Optional. Enter comma-separated ACF field keys to include in search (e.g. "
"company_name, project_code). If left blank, ACF fields will not be searched."
msgstr ""
"Không bắt buộc. Nhập các khóa trường ACF, cách nhau bằng dấu phẩy, để đưa "
"vào tìm kiếm (ví dụ: company_name, project_code). Nếu để trống, plugin sẽ "
"không tìm trong các trường ACF."

#: includes/settings/general.php:315
msgid "Search in SEO Metadata?"
msgstr "Tìm trong metadata SEO?"

#: includes/settings/general.php:319
msgid ""
"Include SEO Title and Meta Description (Yoast, Rank Math, TSF, etc.) in "
"search matching."
msgstr ""
"Tìm kiếm trong tiêu đề SEO và mô tả meta (Yoast, Rank Math, TSF, v.v...) để "
"cải thiện độ chính xác."

#: includes/settings/general.php:321
msgid ""
"Enable this to improve accuracy by searching within SEO-optimized content "
"written by the author."
msgstr ""
"Bật tùy chọn này để cải thiện kết quả bằng cách tìm trong nội dung SEO mà "
"tác giả đã tối ưu."

#: includes/settings/general.php:325
msgid "Enable Synonym Expansion?"
msgstr "Bật chức năng mở rộng từ đồng nghĩa?"

#: includes/settings/general.php:329
msgid ""
"Allow search terms to be expanded using built-in or custom-defined synonyms."
msgstr ""
"Cho phép mở rộng cụm từ tìm kiếm bằng cách sử dụng từ đồng nghĩa có sẵn hoặc "
"do bạn tự định nghĩa."

#: includes/settings/general.php:332
msgid ""
"Enable this only after defining useful synonym mappings. Otherwise, it will "
"have no effect."
msgstr ""
"Chỉ nên bật khi bạn đã khai báo các từ đồng nghĩa phù hợp. Nếu không, tính "
"năng này sẽ không tạo ra hiệu quả."

#: includes/settings/general.php:337
msgid "Enable fallback matching?"
msgstr "Bật khớp dự phòng?"

#: includes/settings/general.php:341
msgid "Try trimming or using bigrams if not enough results are found."
msgstr "Thử rút gọn hoặc sử dụng cụm từ nếu không đủ kết quả."

#: includes/settings/general.php:346
msgid "Enable Search Analytics?"
msgstr "Bật phân tích tìm kiếm?"

#: includes/settings/general.php:350
msgid "Log search queries (term, result count) for analytics purposes."
msgstr ""
"Ghi lại các truy vấn tìm kiếm (từ khóa, số lượng kết quả) để phục vụ phân "
"tích."

#: includes/settings/general.php:352
msgid ""
"When enabled, search data will be stored temporarily using transients to "
"help analyze usage trends. No IPs or personal data are stored."
msgstr ""
"Khi được bật, dữ liệu tìm kiếm sẽ được lưu tạm thời bằng transient để phân "
"tích xu hướng sử dụng. Không lưu địa chỉ IP hoặc dữ liệu cá nhân."

#: includes/settings/general.php:356
msgid "Auto Redirect 404 to Best Match?"
msgstr "Tự động chuyển hướng 404 sang bài viết liên quan nhất?"

#: includes/settings/general.php:365
msgid ""
"When a 404 page is requested, automatically redirect to the most relevant "
"post found by Init Live Search."
msgstr ""
"Khi người dùng vào trang 404, tự động chuyển hướng sang bài viết liên quan "
"nhất được tìm thấy bởi Init Live Search."

#: includes/settings/general.php:368
msgid "Leave unchecked to keep the default 404 behavior of your theme."
msgstr "Bỏ chọn để giữ nguyên hành vi 404 mặc định của giao diện."

#: includes/settings/general.php:373
msgid "Performance & UX"
msgstr "Hiệu năng & Trải nghiệm người dùng"

#: includes/settings/general.php:376
msgid "Debounce Time (ms)"
msgstr "Thời gian chờ tìm kiếm (ms)"

#: includes/settings/general.php:382
msgid "Max Results"
msgstr "Số kết quả tối đa"

#: includes/settings/general.php:385
msgid "Maximum number of results to display in the modal."
msgstr "Số lượng kết quả tối đa hiển thị trong hộp tìm kiếm."

#: includes/settings/general.php:389
msgid "Max Words to Trigger Highlight Search"
msgstr "Số từ tối đa để bật tìm kiếm khi bôi đen"

#: includes/settings/general.php:392
msgid ""
"Set maximum word count allowed to trigger tooltip search on text selection. "
"Set 0 to disable."
msgstr ""
"Thiết lập số từ tối đa được phép để hiển thị tooltip tìm kiếm khi người dùng "
"bôi đen văn bản. Nhập 0 để tắt chức năng này."

#: includes/settings/general.php:396
msgid "Enable Voice Input?"
msgstr "Bật nhập liệu bằng giọng nói?"

#: includes/settings/general.php:400
msgid "Enable microphone input using the SpeechRecognition API (if supported)"
msgstr ""
"Bật nhập liệu bằng micro sử dụng SpeechRecognition API (nếu trình duyệt hỗ "
"trợ)"

#: includes/settings/general.php:405
msgid "Cache results in localStorage?"
msgstr "Lưu kết quả vào localStorage?"

#: includes/settings/general.php:409
msgid ""
"Enable caching search results in localStorage to improve performance and "
"reduce repeated requests."
msgstr ""
"Lưu kết quả tìm kiếm vào localStorage để tăng hiệu suất và giảm yêu cầu lặp "
"lại."

