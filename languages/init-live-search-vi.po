msgstr ""
"Tùy chọn. Thiết lập UTM mặc định thêm vào URL tìm kiếm. Ví dụ: "
"utm_source=search&utm_medium=plugin"

#: includes/settings/general.php:477
msgid "Suggested Keywords"
msgstr "Từ khóa gợi ý"

#: includes/settings/general.php:480
msgid "Generate Automatically"
msgstr "Tự động tạo"

#: includes/settings/general.php:481
