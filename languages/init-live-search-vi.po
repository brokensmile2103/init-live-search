msgstr ""
"Chọn cách hiển thị modal tìm kiếm ở frontend. Bạn có thể tắt toàn bộ style "
"và tự viết lại nếu muốn."

#: includes/settings/general.php:443
msgid "Auto Insert Related Posts?"
msgstr "Tự động chèn bài viết liên quan?"

#: includes/settings/general.php:448
msgid "No (manual shortcode only)"
msgstr "Không (chỉ dùng shortcode thủ công)"

#: includes/settings/general.php:452
msgid "After post content"
msgstr "Sau nội dung bài viết"

#: includes/settings/general.php:456
